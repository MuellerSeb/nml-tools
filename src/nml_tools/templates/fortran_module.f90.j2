  !> \brief Check whether a namelist value was set
  integer function {{ type_prefix }}_is_set(nml__obj, name, idx, errmsg) result(nml__status)
    class({{ type_name }}), intent(in) :: nml__obj !< namelist instance
    character(len=*), intent(in) :: name !< field name
    integer, intent(in), optional :: idx(:) !< optional field index values
    character(len=*), intent(out), optional :: errmsg !< error message for non-OK status values

    nml__status = NML_OK
    if (nml__present(errmsg)) errmsg = ""
    if (.not. nml__obj%is_configured) then
      nml__status = NML_ERR_NOT_SET
      if (nml__present(errmsg)) errmsg = "namelist not configured; call set or from_file"
      return
    end if
    select case (to_lower(nml__trim(name)))
{% for case in presence_cases %}
    case ("{{ case.name }}")
{% if case.is_array %}
{% if case.runtime_array %}
      if (.not. nml__allocated(nml__obj%data%{{ case.name }})) then
        nml__status = NML_ERR_NOT_SET
        return
      end if
{% endif %}
      if (nml__present(idx)) then
        nml__status = idx_check(idx, nml__shape(nml__obj%data%{{ case.name }}), &
          "{{ case.display_name }}", errmsg)
        if (nml__status /= NML_OK) return
{% if not case.always_true %}
        if ({{ case.element_condition }}) nml__status = NML_ERR_NOT_SET
{% endif %}
      else
{% if not case.always_true %}
        if ({{ case.sentinel_condition }}) nml__status = NML_ERR_NOT_SET
{% endif %}
      end if
{% else %}
      if (nml__present(idx)) then
        nml__status = NML_ERR_INVALID_INDEX
        if (nml__present(errmsg)) errmsg = "index not supported for '{{ case.display_name }}'"
        return
      end if
{% if not case.always_true %}
      if ({{ case.sentinel_condition }}) nml__status = NML_ERR_NOT_SET
{% endif %}
{% endif %}
{% endfor %}
{% for block in derived_presence_blocks %}
{{ block | indent(4, True) }}
{% endfor %}
    case default
      nml__status = NML_ERR_INVALID_NAME
      if (nml__present(errmsg)) errmsg = "unknown field: " // nml__trim(name)
    end select
    if (nml__status == NML_ERR_NOT_SET .and. nml__present(errmsg)) then
      if (nml__len_trim(errmsg) == 0) errmsg = "field not set: " // nml__trim(name)
    end if
  end function {{ type_prefix }}_is_set

{% if flex_arrays %}
  !> \brief Determine the filled shape along flexible dimensions
  integer function {{ type_prefix }}_filled_shape(nml__obj, name, filled, errmsg) result(nml__status)
    class({{ type_name }}), intent(in) :: nml__obj !< namelist instance
    character(len=*), intent(in) :: name !< field name
    integer, intent(out) :: filled(:) !< filled shape of the requested field
    character(len=*), intent(out), optional :: errmsg !< error message for non-OK status values
    integer :: nml__idx
    integer :: nml__dim

    nml__status = NML_OK
    if (nml__present(errmsg)) errmsg = ""
    select case (to_lower(nml__trim(name)))
{% for flex in flex_arrays %}
    case ("{{ flex.name }}")
      if (nml__size(filled) /= {{ flex.rank }}) then
        nml__status = NML_ERR_INVALID_INDEX
        if (nml__present(errmsg)) errmsg = "shape rank mismatch for '{{ flex.display_name }}'"
        return
      end if
{% if flex.runtime_array %}
      if (.not. nml__allocated(nml__obj%data%{{ flex.name }})) then
        filled = 0
        return
      end if
{% endif %}
      do nml__dim = 1, {{ flex.rank }}
        filled(nml__dim) = nml__size(nml__obj%data%{{ flex.name }}, nml__dim)
      end do
{% for dim in flex.flex_dims %}
      filled({{ dim }}) = 0
      do nml__idx = nml__size(nml__obj%data%{{ flex.name }}, {{ dim }}), 1, -1
        if (.not. ({{ flex.slice_missing_conditions[loop.index0] }})) then
          filled({{ dim }}) = nml__idx
          exit
        end if
      end do
{% endfor %}
      if (nml__minval(filled) > 0) then
        if ({{ flex.prefix_any_missing_condition }}) then
          nml__status = NML_ERR_PARTLY_SET
          if (nml__present(errmsg)) errmsg = "array partly set: {{ flex.display_name }}"
          return
        end if
      end if
{% endfor %}
    case default
      nml__status = NML_ERR_INVALID_NAME
      if (nml__present(errmsg)) errmsg = "field is not a flexible array: " // nml__trim(name)
    end select
  end function {{ type_prefix }}_filled_shape

{% endif %}
  !> \brief Validate required values and constraints
  integer function {{ type_prefix }}_is_valid(nml__obj, errmsg) result(nml__status)
    class({{ type_name }}), intent(in) :: nml__obj !< namelist instance
    character(len=*), intent(out), optional :: errmsg !< error message for non-OK status values
    integer :: nml__istat
{% if flex_arrays %}
    integer, allocatable :: nml__filled(:)
{% endif %}

    nml__status = NML_OK
    if (nml__present(errmsg)) errmsg = ""
    if (.not. nml__obj%is_configured) then
      nml__status = NML_ERR_NOT_SET
      if (nml__present(errmsg)) errmsg = "namelist not configured; call set or from_file"
      return
    end if

{% if required_scalar_validations %}
    ! required parameters
{% for name in required_scalar_validations %}
    nml__istat = nml__obj%is_set("{{ name }}", errmsg=errmsg)
    if (nml__istat == NML_ERR_NOT_SET) then
      nml__status = NML_ERR_REQUIRED
      if (nml__present(errmsg)) then
        if (nml__len_trim(errmsg) == 0) then
          errmsg = "field not set: {{ name }}"
        end if
        errmsg = "required " // nml__trim(errmsg)
      end if
      return
    end if
    if (nml__istat /= NML_OK) then
      nml__status = nml__istat
      return
    end if
{% endfor %}
{% endif %}
{% if required_array_validations %}
    ! required arrays
{% for entry in required_array_validations %}
{% if entry.runtime_array %}
    if (.not. nml__allocated(nml__obj%data%{{ entry.attr_name }})) then
      nml__status = NML_ERR_REQUIRED
      if (nml__present(errmsg)) errmsg = "required field not set: {{ entry.name }}"
      return
    end if
{% endif %}
    if ({{ entry.all_missing_condition }}) then
      nml__status = NML_ERR_REQUIRED
      if (nml__present(errmsg)) errmsg = "required field not set: {{ entry.name }}"
      return
    end if
    if ({{ entry.any_missing_condition }}) then
      nml__status = NML_ERR_PARTLY_SET
      if (nml__present(errmsg)) errmsg = "array partly set: {{ entry.name }}"
      return
    end if
{% endfor %}
{% endif %}
{% if flex_arrays %}
    ! flexible arrays
{% for entry in flex_arrays %}
    if (nml__allocated(nml__filled)) deallocate(nml__filled)
    allocate(nml__filled({{ entry.rank }}))
    nml__istat = nml__obj%filled_shape( &
      "{{ entry.display_name }}", nml__filled, errmsg=errmsg)
    if (nml__istat == NML_ERR_PARTLY_SET) then
      nml__status = nml__istat
      if (nml__present(errmsg)) then
        if (nml__len_trim(errmsg) == 0) errmsg = "array partly set: {{ entry.display_name }}"
      end if
      return
    end if
    if (nml__istat /= NML_OK) then
      nml__status = nml__istat
      return
    end if
{% if entry.required %}
    if (nml__minval(nml__filled) == 0) then
      nml__status = NML_ERR_REQUIRED
      if (nml__present(errmsg)) errmsg = "required field not set: {{ entry.display_name }}"
      return
    end if
{% endif %}
{% endfor %}
{% endif %}
{% if enum_checks %}
    ! enum constraints
{% for check in enum_checks %}
{% if check.is_array %}
{% if check.runtime_array %}
    if (nml__allocated({{ check.allocation_ref }})) then
{% endif %}
    if (.not. nml__all({{ check.func_name }}({{ check.array_ref }}, allow_missing=.true.))) then
      nml__status = NML_ERR_ENUM
      if (nml__present(errmsg)) errmsg = "enum constraint failed: {{ check.display_name }}"
      return
    end if
{% if check.runtime_array %}
    end if
{% endif %}
{% else %}
    nml__istat = nml__obj%is_set("{{ check.display_name }}", errmsg=errmsg)
    if (nml__istat == NML_OK) then
      if (.not. {{ check.func_name }}({{ check.element_ref }})) then
        nml__status = NML_ERR_ENUM
        if (nml__present(errmsg)) errmsg = "enum constraint failed: {{ check.display_name }}"
        return
      end if
    else if (nml__istat /= NML_ERR_NOT_SET) then
      nml__status = nml__istat
      return
    end if
{% endif %}
{% endfor %}
{% endif %}
{% if bounds_checks %}
    ! bounds constraints
{% for check in bounds_checks %}
{% if check.is_array %}
{% if check.runtime_array %}
    if (nml__allocated({{ check.allocation_ref }})) then
{% endif %}
    if (.not. nml__all({{ check.func_name }}({{ check.array_ref }}, allow_missing=.true.))) then
      nml__status = NML_ERR_BOUNDS
      if (nml__present(errmsg)) errmsg = "bounds constraint failed: {{ check.display_name }}"
      return
    end if
{% if check.runtime_array %}
    end if
{% endif %}
{% else %}
    nml__istat = nml__obj%is_set("{{ check.display_name }}", errmsg=errmsg)
    if (nml__istat == NML_OK) then
      if (.not. {{ check.func_name }}({{ check.element_ref }})) then
        nml__status = NML_ERR_BOUNDS
        if (nml__present(errmsg)) errmsg = "bounds constraint failed: {{ check.display_name }}"
        return
      end if
    else if (nml__istat /= NML_ERR_NOT_SET) then
      nml__status = nml__istat
      return
    end if
{% endif %}
{% endfor %}
{% endif %}
  end function {{ type_prefix }}_is_valid

end module {{ module_name }}
